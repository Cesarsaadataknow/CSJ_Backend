# =============================================
# Variables de entorno del Frontend
# =============================================
# Copiar este archivo como .env y completar los valores.
# Las variables con prefijo VITE_ son accesibles en el código del frontend.

# --- Autenticación Microsoft (MSAL) ---
# Obligatorias para el login con Azure AD
VITE_CLIENT_ID=tu-client-id-de-azure-ad
VITE_TENANT_ID=tu-tenant-id
VITE_REDIRECT_URI=http://localhost:8501

# --- API Backend principal ---
# URL base del API backend (sin /api al final).
# En desarrollo se usa http://localhost:8000 por defecto.
# VITE_APP_API_URL=http://localhost:8000

# --- SQL / Catálogo (opcional) ---
# Solo necesario si se habilita el módulo SQL.
# VITE_CATALOG=nombre_del_catalogo
# VITE_APP_API_URL_SQL=http://localhost:8000
